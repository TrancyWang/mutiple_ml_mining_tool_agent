# ====================================
# LLM 服务配置（优先级策略）
# ====================================
# 
# 优先级顺序：
# 1. Google Gemini 服务 (GOOGLE_API_KEY) - 默认
# 2. 新加坡阿里云 Qwen 服务 (ALIYUN_API_KEY / DASHSCOPE_API_KEY_SG) - 兜底
# 3. 中国内地阿里云 Qwen 服务 (DASHSCOPE_API_KEY_BJ) - 可选
# 4. 本地 Ollama 模型 - 兜底（无需配置）
#
# 使用说明：
# - 复制此文件为 .env
# - 填入对应的 API Key
# - 系统会自动按优先级选择可用的服务
# - 参考 Quran_assitant 项目的实现方式

# 当前 Qt 客户端顶栏可手动切换：auto / gemini / qwen / qwen-beijing / ollama
# auto 保持 Gemini 默认、Qwen（新加坡优先，北京其次）兜底、Ollama 最后兜底
LLM_PROVIDER=auto

# ====================================
# 1. 阿里云 DashScope API Key（新加坡节点）
# ====================================
# 获取方式：https://dashscope.console.aliyuncs.com/
# 注意：使用国际版（新加坡）节点
# 支持多种环境变量名称（兼容 Quran_assitant）
ALIYUN_API_KEY=your_aliyun_api_key_here
# 或者使用以下任一名称：
# DASHSCOPE_API_KEY_SG=your_dashcope_api_key
# QWEN_API_KEY_SG=your_qwen_api_key

# ====================================
# 1.1 阿里云 DashScope API Key（中国内地/北京节点）
# ====================================
# OpenAI-compatible endpoint: https://dashscope.aliyuncs.com/compatible-mode/v1
# 也可使用 QWEN_API_KEY_BJ 或 QWEN_BEIJING_API_KEY
# DASHSCOPE_API_KEY_BJ=your_dashscope_beijing_api_key

# 阿里云模型配置（当使用远程模式时）
QWEN_MODEL=qwen-plus
# 可选模型: qwen-plus, qwen-max, qwen-turbo, qwen-long

# ====================================
# 2. Google AI Studio API Key
# ====================================
# 获取方式：https://makersuite.google.com/
GOOGLE_API_KEY=your_google_api_key_here
# Gemini 的 OpenAI-compatible endpoint（qwen-agent 通过此方式调用）
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ====================================
# 3. 本地 Ollama 配置（兜底方案）
# ====================================
# Ollama 服务地址
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3.5:2b

# 默认使用的 Gemini 模型；未配置 Gemini 时自动切换到新加坡 Qwen
DEFAULT_MODEL=gemini-3.6-flash
# Agent 可选模型: qwen3.5:2b（推荐工具调用）, qwen3.5:0.8b（工具调用）
# qwen3:0.6b 不放入菜单，仅供内部意图识别、响应分类、行为判断等轻量文本任务使用

# ====================================
# 3.1 大模型实体识别/关系抽取（可选）
# ====================================
# 默认复用 LLM_PROVIDER、已有 Gemini/Qwen/Ollama 配置；如需单独指定服务，可覆盖以下变量
# LLM_EXTRACTION_PROVIDER=ollama
# LLM_EXTRACTION_MODEL=qwen3.5:2b
# LLM_EXTRACTION_BASE_URL=http://localhost:11434/v1
# LLM_EXTRACTION_API_KEY=EMPTY
# LLM_EXTRACTION_TIMEOUT=90

# ====================================
# 其他配置（可选）
# ====================================
# 用户只输入 Skill 名称时，默认扫描当前项目 skills/；可追加一个或多个来源目录
# ACADEMIC_AGENT_SKILLS_SOURCE_DIR=/path/to/skills
# 安装后的 Skill 保存目录；默认是 runtime/skills/
# ACADEMIC_AGENT_SKILLS_DIR=/path/to/installed-skills
# Gradio 服务端口
GRADIO_PORT=7860

# ====================================
# 多模态 Provider（按需配置）
# ====================================
# 可选：gemini / qwen / local
MULTIMODAL_PROVIDER=gemini
MULTIMODAL_MODEL=gemini-3.6-flash
# 本地或 OpenAI-compatible 多模态服务，例如 http://localhost:8000/v1
MULTIMODAL_BASE_URL=http://localhost:8000/v1
MULTIMODAL_API_KEY=

# ====================================
# 4. 语音转文本（对话框中的“语音输入”）
# ====================================
# auto 会优先使用当前已配置的 DashScope，其次尝试 Deepgram，再尝试 OpenAI-compatible。
# 也可以明确填写 aliyun / deepgram / openai。
ASR_PROVIDER=auto
ASR_LANGUAGE=zh-CN
ASR_TIMEOUT=90
ASR_POLL_INTERVAL=2
ASR_POLL_ATTEMPTS=30

# DashScope ASR：复用上面的 DASHSCOPE_API_KEY_SG/BJ 或 ALIYUN_API_KEY。
# 新加坡默认使用 fun-asr，北京默认使用 paraformer-v2。
DASHSCOPE_DEFAULT_REGION=sg
DASHSCOPE_ENDPOINT_SG=https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_ENDPOINT_BJ=https://dashscope.aliyuncs.com/api/v1
# ASR_MODEL=fun-asr
# ASR_MODEL_SG=fun-asr
# ASR_MODEL_BJ=paraformer-v2

# Deepgram（ASR_PROVIDER=deepgram 时使用）
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=zh-CN
DEEPGRAM_PUNCTUATE=true
DEEPGRAM_SMART_FORMAT=true

# OpenAI-compatible Whisper 服务（ASR_PROVIDER=openai 时使用）
# ASR_BASE_URL=http://localhost:8000/v1
# ASR_API_KEY=
# ASR_TRANSCRIPTIONS_URL=http://localhost:8000/v1/audio/transcriptions

# ====================================
# 5. 文档 Agentic RAG（集成到 Academic Agent）
# ====================================
# 默认索引写入 runtime/rag_datasets；可按需指定独立目录
RAG_DATA_DIR=
RAG_EMBEDDING_DIM=768
# 可选 OpenAI-compatible embedding/chat 服务；未配置时使用本地哈希向量，最终答案由当前 Qwen-Agent 生成
RAG_OPENAI_BASE_URL=
RAG_OPENAI_API_KEY=
RAG_CHAT_MODEL=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=
RAG_TIMEOUT=90

# ====================================
# 4. 记忆存储（ES + Milvus）
# ====================================
# Milvus Lite 默认使用项目目录下的本地数据库，不需要额外启动服务
MILVUS_ENABLED=false
MILVUS_URI=./milvus_data/academic_memories.db
MILVUS_COLLECTION=academic_agent_memories_llamaindex
MILVUS_EMBEDDING_DIM=768

# Elasticsearch 用于保存完整会话和关键词检索；未启动时自动跳过
ES_ENABLED=false
ES_HOST=http://localhost:9200
ES_INDEX=academic_agent_conversations
ES_USER=elastic
ES_PASSWORD=

# Text2SQL 业务指标目录（JSON）；MySQL 连接密码不写入 .env
# TEXT2SQL_ONTOLOGY_PATH=/path/to/text2sql_ontology.json
ES_VERIFY_CERTS=false

# 新版文本算法源项目（目标项目只读调用，不修改源项目）。
# 根目录必须包含 src_code/。
TEXT_MINING_SOURCE_ROOT=/Users/trancy/PycharmProjects/acdamic_tools/text_mining_tools_agent_client_cpu
PRETRAINED_MODELS_DIR=/Users/trancy/PycharmProjects/acdamic_tools/text_mining_tools_agent_client_cpu/pretrain_models
