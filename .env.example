# ====================================
# LLM 服务配置（优先级策略）
# ====================================
# 
# 优先级顺序：
# 1. Google Gemini 服务 (GOOGLE_API_KEY) - 默认
# 2. 新加坡阿里云 Qwen 服务 (ALIYUN_API_KEY / DASHSCOPE_API_KEY_SG) - 兜底
# 3. 本地 Ollama 模型 - 兜底（无需配置）
#
# 使用说明：
# - 复制此文件为 .env
# - 填入对应的 API Key
# - 系统会自动按优先级选择可用的服务
# - 参考 Quran_assitant 项目的实现方式

# 当前 Qt 客户端顶栏可手动切换：auto / gemini / qwen / ollama
# auto 保持 Gemini 默认、Qwen 新加坡兜底、Ollama 最后兜底
LLM_PROVIDER=auto

# ====================================
# 1. 阿里云 DashScope API Key（新加坡节点）
# ====================================
# 获取方式：https://dashscope.console.aliyuncs.com/
# 注意：使用国际版（新加坡）节点
# 支持多种环境变量名称（兼容 Quran_assitant）
ALIYUN_API_KEY=your_aliyun_api_key_here
# 或者使用以下任一名称：
# DASHSCOPE_API_KEY_SG=your_dashcope_api_key
# QWEN_API_KEY_SG=your_qwen_api_key

# 阿里云模型配置（当使用远程模式时）
QWEN_MODEL=qwen-plus
# 可选模型: qwen-plus, qwen-max, qwen-turbo, qwen-long

# ====================================
# 2. Google AI Studio API Key
# ====================================
# 获取方式：https://makersuite.google.com/
GOOGLE_API_KEY=your_google_api_key_here
# Gemini 的 OpenAI-compatible endpoint（qwen-agent 通过此方式调用）
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ====================================
# 3. 本地 Ollama 配置（兜底方案）
# ====================================
# Ollama 服务地址
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3.5:2b

# 默认使用的 Gemini 模型；未配置 Gemini 时自动切换到新加坡 Qwen
DEFAULT_MODEL=gemini-3.6-flash
# Agent 可选模型: qwen3.5:2b（推荐工具调用）, qwen3.5:0.8b（工具调用）
# qwen3:0.6b 不放入菜单，仅供内部意图识别、响应分类、行为判断等轻量文本任务使用

# ====================================
# 其他配置（可选）
# ====================================
# Gradio 服务端口
GRADIO_PORT=7860

# ====================================
# 多模态 Provider（按需配置）
# ====================================
# 可选：gemini / qwen / local
MULTIMODAL_PROVIDER=gemini
MULTIMODAL_MODEL=gemini-3.6-flash
# 本地或 OpenAI-compatible 多模态服务，例如 http://localhost:8000/v1
MULTIMODAL_BASE_URL=http://localhost:8000/v1
MULTIMODAL_API_KEY=

# ====================================
# 4. 记忆存储（ES + Milvus）
# ====================================
# Milvus Lite 默认使用项目目录下的本地数据库，不需要额外启动服务
MILVUS_ENABLED=false
MILVUS_URI=./milvus_data/academic_memories.db
MILVUS_COLLECTION=academic_agent_memories_llamaindex
MILVUS_EMBEDDING_DIM=768

# Elasticsearch 用于保存完整会话和关键词检索；未启动时自动跳过
ES_ENABLED=false
ES_HOST=http://localhost:9200
ES_INDEX=academic_agent_conversations
ES_USER=elastic
ES_PASSWORD=
ES_VERIFY_CERTS=false

# 源项目通用文本算法实现（目标项目只读调用，不修改源项目）
VIDEO_AGENT_SOURCE_ROOT=/Users/trancy/PycharmProjects/acdamic_tools/video_text_mutiplemodal_agent
PRETRAINED_MODELS_DIR=/Users/trancy/PycharmProjects/acdamic_tools/video_text_mutiplemodal_agent/pretrain_models
